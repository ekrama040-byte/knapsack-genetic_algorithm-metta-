(= (calculate-weight Nil Nil) 0)
(= (calculate-weight (Cons $gene $g-rest) (Cons (Item $w $v) $i-rest))
   (if (== $gene 1)
       (+ $w (calculate-weight $g-rest $i-rest))
       (calculate-weight $g-rest $i-rest)))

(= (calculate-value Nil Nil) 0)
(= (calculate-value (Cons $gene $g-rest) (Cons (Item $w $v) $i-rest))
   (if (== $gene 1)
       (+ $v (calculate-value $g-rest $i-rest))
       (calculate-value $g-rest $i-rest)))
